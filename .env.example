# Server
PORT=8000
# Port yang digunakan untuk menjalankan server

DEBUG=false
# true/false

SECRET_KEY=ganti-dengan-random-string-yang-panjang
# Secret key untuk signing token & session

# Database
DATABASE_URL=presensee.db
# SQLite  : presensee.db (atau path file .db lainnya)
# Postgres: postgresql://user:password@host:5432/presensee
# MySQL   : user:password@tcp(host:3306)/presensee

# Redis (opsional, untuk caching file rekap)
REDIS_URL=
# contoh: redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=*
# contoh: https://presensee.sekolah.id
# gunakan * untuk development

# Timezone
TIME_ZONE=Asia/Jakarta

# Media / Upload
MEDIA_DIR=./media
# Direktori penyimpanan file upload (foto profil, logo, kop)

# Frontend
# Jika frontend sudah di-build, letakkan hasil build di ./frontend/dist
# Server akan otomatis serve file statis dari direktori tersebut
